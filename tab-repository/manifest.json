{
  "id": "nexus.tab-repository",
  "displayName": "Tab Repository",
  "version": "0.1.11",
  "apiVersion": 2,
  "schemaVersion": 1,
  "description": "Repositorio por vault para descargar tabs de Brave, organizarlas y devolverlas por lotes.",
  "author": "NEW-NEXUS",
  "permissions": [
    "browser.tabs.read",
    "browser.tabs.manage",
    "host.node"
  ],
  "entrypoints": {
    "backend": "./dist/backend.cjs",
    "renderer": "./dist/renderer.js"
  },
  "contributes": {
    "views": [],
    "sideToolbar": [],
    "frameMenu": [],
    "fileExplorerHeader": [],
    "engines": [],
    "ipc": {
      "operations": [
        "browser-commit",
        "browser-preview",
        "browser-send",
        "get-snapshot",
        "group-create",
        "group-delete",
        "group-rename",
        "groups-reorder",
        "json-export",
        "json-import",
        "regroup-domain",
        "tabs-move",
        "tabs-reorder",
        "tabs-restore",
        "tabs-trash",
        "trash-empty"
      ]
    }
  }
}

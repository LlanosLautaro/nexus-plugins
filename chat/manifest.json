{
  "id": "nexus.chat",
  "displayName": "Chat",
  "version": "0.1.7",
  "apiVersion": 2,
  "schemaVersion": 1,
  "description": "Chat local minimo para LM Studio dentro de Nexus.",
  "author": "NEW-NEXUS",
  "entrypoints": {
    "backend": "./dist/backend.cjs",
    "renderer": "./dist/renderer.js"
  },
  "contributes": {
    "views": [],
    "sideToolbar": [],
    "frameMenu": [],
    "fileExplorerHeader": [],
    "engines": [],
    "ipc": {
      "operations": [
        "list-models",
        "load-model",
        "send-message"
      ]
    }
  },
  "permissions": [
    "host.node"
  ]
}
